{
  "name": "@mnl-dev-telemetry/setup",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "mnl-dev-telemetry-setup": "./dist/cli.js"
  },
  "//": "main/types point at source: this is a workspace-internal package and its only in-process consumer (the VS Code extension) bundles it with esbuild. The shipped artefacts stay the two CJS bundles in dist/.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mnl-dev-telemetry/shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

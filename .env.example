# --- Database ---
# Local Docker default below. On a host (Neon / Vercel Postgres / Supabase) use
# the POOLED connection string for the app; SSL + a small pool are auto-applied
# for non-localhost URLs. DB_POOL_MAX overrides the pool size (default 3 hosted).
DATABASE_URL=postgres://devpulse:devpulse@localhost:5432/devpulse
# DB_POOL_MAX=3

# --- Dashboard / Auth (Phase 4+) ---
# Required by Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google Workspace SSO (production sign-in). Leave blank to hide the Google button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Dev-login fallback: when true, the login page accepts any email with no
# password and provisions the user on the spot. Great for early team testing;
# a real security tradeoff (anyone who can reach the URL can sign in). Pair it
# with Vercel Deployment Protection, or switch to Google SSO and set this false.
DEV_LOGIN_ENABLED=false
# Public URL of the dashboard. Drives the /activate link the setup CLI prints —
# MUST be the deployed origin in production (e.g. https://mnl-dev-telemetry-dashboard.vercel.app).
APP_URL=http://localhost:3000
# Auth.js canonical URL for OAuth callbacks (set to the deployed origin in prod).
# AUTH_URL=https://mnl-dev-telemetry-dashboard.vercel.app

# --- Cron (Phase 4/5) ---
# When set, the /api/cron/* routes require `Authorization: Bearer <secret>`.
# /api/cron/nightly is the single daily job (stitch → rollup → sync retry);
# Vercel Hobby allows only one cron per day, hence one combined route.
CRON_SECRET=

# --- Credential encryption (Phase 5, REQUIRED to connect Jira) ---
# 32 bytes, base64 or hex. Generate with: openssl rand -base64 32
# Encrypts jira_connections.auth / .tempo_auth at rest (spec §5). Rotating this
# invalidates every stored connection — devs would need to reconnect.
ENCRYPTION_KEY=

# --- Jira Cloud OAuth 2.0 (3LO), per-user (Phase 5) ---
# From developer.atlassian.com → Console → your app → Authorization / Settings.
# Callback URL must be registered there EXACTLY as: <APP_URL>/api/jira/callback
# Scopes requested: read:jira-work write:jira-work read:jira-user offline_access
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=

# --- Tempo (Phase 5) ---
# Tempo auth is NOT Jira auth: linking Jira grants no Tempo access. Each dev
# pastes their own Tempo API token in Settings (Tempo → Settings → Data Access →
# API integration); it is stored encrypted server-side. Nothing to set here
# unless your Tempo data lives in a regional cluster:
#   https://api.eu.tempo.io (Europe) | https://api.us.tempo.io (Americas)
# TEMPO_API_BASE_URL=https://api.tempo.io

# --- Optional org-level Jira service account (Phase 5, mirror tickets only) ---
# Used ONLY to create mirror tickets in OUR Jira when a client project has no
# connection (spec §4.6). Leave blank to disable mirroring. Basic auth:
# JIRA_BASE_URL is the site (https://your-org.atlassian.net), JIRA_API_TOKEN is
# an Atlassian API token for JIRA_EMAIL. MIRROR_PROJECT_KEY is where mirrors land.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
MIRROR_PROJECT_KEY=
# Issue type used for created mirror tickets (must exist in MIRROR_PROJECT_KEY).
MIRROR_ISSUE_TYPE=Task

# --- Stitching / working-hours defaults (Phase 4) ---
STITCH_GAP_MINUTES=45
DEFAULT_TZ=Asia/Manila
WORKDAY_START=09:00
WORKDAY_END=18:00
